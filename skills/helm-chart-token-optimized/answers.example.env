# answers.env — fill this in, then run:  ./scaffold.sh --answers answers.env --out ./
# KEY=VALUE shell assignments. Quote values with spaces. Required: CHART_NAME,
# IMAGE_REPOSITORY, IMAGE_TAG. Everything else has a safe production default —
# delete a line to accept its default.

# --- Identity (Group 1) ---
CHART_NAME=orders-api
DESCRIPTION="Orders REST API"
APP_VERSION=2.3.0
MAINTAINER=team

# --- Image (Group 1) ---
IMAGE_REGISTRY=docker.io
IMAGE_REPOSITORY=acme/orders-api
IMAGE_TAG=2.3.0

# --- Workload (Group 1) ---
CONTAINER_PORT=8080
WORKLOAD=Deployment            # Deployment | StatefulSet | DaemonSet
REPLICA_COUNT=1

# --- Networking (Group 2) ---
SERVICE_TYPE=ClusterIP         # ClusterIP | NodePort | LoadBalancer
SERVICE_PORT=80
INGRESS_ENABLED=false
INGRESS_HOSTNAME=              # default: <chart>.local
INGRESS_CLASS=
INGRESS_TLS=none               # none | cert-manager | self-signed

# --- Security (Group 4) ---
RUN_AS_USER=1001
READ_ONLY_ROOT_FS=true
SA_CREATE=true
SECRETS_ENABLED=false
CONFIGMAP_ENABLED=false

# --- Reliability (Group 3) ---
HPA_ENABLED=false              # Deployment only
HPA_MIN=2
HPA_MAX=5
HPA_TARGET_CPU=80
PDB_ENABLED=false
PDB_MIN_AVAILABLE=1

# --- Persistence & Observability (Group 5) ---
PERSISTENCE_ENABLED=false
PERSISTENCE_SIZE=8Gi
PERSISTENCE_MOUNT=/data
METRICS_ENABLED=false
METRICS_PORT=9090
SERVICEMONITOR_ENABLED=false
NETWORKPOLICY_ENABLED=false
