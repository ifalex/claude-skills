# answers.all-features.env — every optional feature enabled.
# Used by lint-all-features.sh to exercise all conditional templates and every
# schema-validated value in one render (schema <-> values coverage check).
# Workload is Deployment so HPA and the standalone PVC paths are exercised too.

CHART_NAME=all-features
DESCRIPTION="All features enabled (lint fixture)"
APP_VERSION=1.0.0
MAINTAINER=team

IMAGE_REGISTRY=docker.io
IMAGE_REPOSITORY=acme/all-features
IMAGE_TAG=1.0.0

CONTAINER_PORT=8080
WORKLOAD=Deployment
REPLICA_COUNT=2

SERVICE_TYPE=ClusterIP
SERVICE_PORT=80
INGRESS_ENABLED=true
INGRESS_HOSTNAME=all-features.example.com
INGRESS_CLASS=nginx
INGRESS_TLS=cert-manager

RUN_AS_USER=10001
READ_ONLY_ROOT_FS=true
SA_CREATE=true
SECRETS_ENABLED=true
CONFIGMAP_ENABLED=true

HPA_ENABLED=true
HPA_MIN=2
HPA_MAX=5
HPA_TARGET_CPU=80
PDB_ENABLED=true
PDB_MIN_AVAILABLE=1

PERSISTENCE_ENABLED=true
PERSISTENCE_SIZE=8Gi
PERSISTENCE_MOUNT=/data
METRICS_ENABLED=true
METRICS_PORT=9090
SERVICEMONITOR_ENABLED=true
NETWORKPOLICY_ENABLED=true
